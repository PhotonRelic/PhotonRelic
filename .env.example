# Read by the scripts in scripts/ from the directory they are run in, when the
# variables are not already in the environment; the file is read line by line,
# never executed, and its values reach no program but wrangler. Copy it with
# (umask 077; cp .env.example .env) so it is readable by you alone; preflight
# fails otherwise. It is never committed.
#
# scripts/mint-tokens.sh can fill in every token below from one bootstrap
# token (docs/deploy.md, "Or let the installer mint them").

# Account: Workers Scripts Edit, Workers R2 Storage Edit, D1 Edit,
# Access: Apps and Policies Edit, Access: Organizations, Identity Providers,
# and Groups Edit. Zone: Workers Routes Edit, DNS Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Comma-separated email domains the library's Access policy lets in.
ACCESS_ALLOWED_EMAIL_DOMAINS=example.com

# Used only if the account has no Zero Trust organization yet:
# provision.sh creates <name>.cloudflareaccess.com.
ACCESS_TEAM_NAME=

# Optional: a second token, Account: Account Analytics Read only, that the
# library reads the resizer's usage dataset with. deploy.sh puts it as the
# library's ANALYTICS_TOKEN secret when it is set here; leave it empty and
# the file page says "not configured".
ANALYTICS_TOKEN=

# Optional, for the library's cache purge after Replace, Delete and a Rescan
# that finds changed bytes: a separate token with the one permission
# Zone: Cache Purge Purge, on the resizer's zone only. When set, deploy.sh
# stores it as the library Worker's CACHE_PURGE_TOKEN secret on every deploy
# (library.toml needs CF_ZONE_ID too). It is never written to any file.
CACHE_PURGE_TOKEN=

# Optional, for masters (the .ai, .psd and raw originals kept beside the web
# copies under masters/): an R2 API token with Object Read & Write on the one
# media bucket, created under R2 → Manage API tokens, no expiry, or minted by
# scripts/mint-tokens.sh --masters once the bucket exists. deploy.sh
# stores both halves as the library Worker's R2_ACCESS_KEY_ID and
# R2_SECRET_ACCESS_KEY secrets on every deploy (library.toml needs
# MEDIA_BUCKET and CF_ACCOUNT_ID too). Leave both empty and the file page says
# masters are not configured; the external master link still works.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
