# Read by scripts/provision.sh and scripts/deploy.sh from the directory they
# are run in, when the variables are not already in the environment. Copy to
# .env; it is never committed.

# Account: Workers Scripts Edit, Workers R2 Storage Edit, D1 Edit,
# Access: Apps and Policies Edit, Access: Organizations, Identity Providers,
# and Groups Edit. Zone: Workers Routes Edit, DNS Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Comma-separated email domains the library's Access policy lets in.
ACCESS_ALLOWED_EMAIL_DOMAINS=example.com

# Used only if the account has no Zero Trust organisation yet:
# provision.sh creates <name>.cloudflareaccess.com.
ACCESS_TEAM_NAME=
